# These keys are identical to the Helm authguard-secrets payload. Replace every
# active placeholder with a single-line production or local-test value.
AUTHGUARD__STORAGE__POSTGRES__PASSWORD=<AUTHGUARD_POSTGRES_PASSWORD>
AUTHGUARD__CACHE__REDIS__PASSWORD=<REDIS_PASSWORD>
AUTHGUARD__AUTHZ__SCOPE_DELIVERY__DIRECT_CONTEXT_HMAC_KEY=<AT_LEAST_32_RANDOM_BYTES>
AUTHGUARD__AUTHZ__API__TOKEN=<AUTHZ_API_TOKEN>
AUTHGUARD__AUTHN__TOKEN__PRIVATE_KEY_B64=<BASE64_PKCS8_RSA_PRIVATE_KEY_PEM>

# Local complete AuthN switches. Set a feature to false when it is not needed.
AUTHGUARD__AUTHN__ACCOUNT_LINKING__STRATEGY=first-login
AUTHGUARD__AUTHN__STANDALONE__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__CREDENTIAL_ENCRYPTION_KEY=<BASE64_32_BYTE_AES_KEY>
AUTHGUARD__AUTHN__STANDALONE__TOTP__ENABLED=true
# Keep this origin and the wallet domain/URI below aligned with Envoy's public
# listener at http://localhost:8080.
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__ENABLED=true
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ID=localhost
AUTHGUARD__AUTHN__STANDALONE__WEBAUTHN__RP_ORIGIN=http://localhost:8080

# Wallet support requires an AuthGuard image built with the web3 feature and
# server-configured CAIP chain RPC entries in authguard.yaml. EOA verification
# remains offline; contract wallet verification uses only these trusted RPCs.
AUTHGUARD__AUTHN__WALLET__ENABLED=false
AUTHGUARD__AUTHN__WALLET__DOMAIN=localhost:8080
AUTHGUARD__AUTHN__WALLET__URI=http://localhost:8080

# Optional provider, directory, and AuthZ re-signing credentials use the same
# reflected keys as Helm. Uncomment only with matching authguard.yaml config.
# AUTHGUARD__AUTHN__PROVIDERS__GITHUB__CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
# AUTHGUARD__AUTHN__PROVIDERS__GOOGLE__CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# AUTHGUARD__AUTHN__PROVIDERS__WECHAT__CLIENT_SECRET=<WECHAT_CLIENT_SECRET>
# AUTHGUARD__AUTHN__PROVIDERS__QQ__CLIENT_SECRET=<QQ_CLIENT_SECRET>
# AUTHGUARD__AUTHN__PROVIDERS__CORPORATE_OIDC__CLIENT_SECRET=<CORPORATE_OIDC_CLIENT_SECRET>
# AUTHGUARD__AUTHZ__PRINCIPAL_DISCOVERY__KEYCLOAK__INDEX_0__AUTH__CLIENT_SECRET=<KEYCLOAK_DISCOVERY_CLIENT_SECRET>
# AUTHGUARD__AUTHZ__PRINCIPAL_DISCOVERY__LDAP__INDEX_0__AUTH__BIND_PASSWORD=<LDAP_BIND_PASSWORD>
# AUTHGUARD__AUTHZ__RESIGN__PRIVATE_KEY_B64=<BASE64_PKCS8_RSA_PRIVATE_KEY_PEM>
