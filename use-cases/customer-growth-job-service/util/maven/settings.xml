<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>e2e-maven-central</id>
      <mirrorOf>central</mirrorOf>
      <url>@MAVEN_MIRROR_URL@</url>
    </mirror>
  </mirrors>
  <proxies>
    <proxy>
      <id>e2e-authguard-build-proxy</id>
      <active>@MAVEN_PROXY_ACTIVE@</active>
      <protocol>http</protocol>
      <host>@MAVEN_PROXY_HOST@</host>
      <port>@MAVEN_PROXY_PORT@</port>
      <nonProxyHosts>localhost|127.0.0.1|maven.aliyun.com</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
