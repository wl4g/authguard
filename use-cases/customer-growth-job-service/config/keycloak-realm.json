{
  "realm": "example-corp",
  "enabled": true,
  "sslRequired": "none",
  "scimApiEnabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "privateKey": "${E2E_REALM_SIGNING_PRIVATE_KEY}",
  "certificate": "${E2E_REALM_SIGNING_CERTIFICATE}",
  "groups": [
    { "id": "11111111-1111-4111-8111-111111111111", "name": "direct-readers" },
    { "id": "22222222-2222-4222-8222-222222222222", "name": "token-editors" }
  ],
  "clients": [
    {
      "clientId": "customer-growth-job-service",
      "name": "Customer Growth Job Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "authguard-group-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "authguard_group_ids",
            "claim.name": "authguard_group_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "customer-growth-job-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "authguard-group",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "authguard_group",
            "claim.name": "authguard_group",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "66666666-6666-4666-8666-666666666666",
      "clientId": "e2e-authguard-principal-discovery",
      "name": "E2E Authguard Principal Discovery",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${E2E_PRINCIPAL_DISCOVERY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "id": "77777777-7777-4777-8777-777777777778",
      "clientId": "e2e-scim-sync",
      "name": "E2E SCIM Background Sync",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AUTHGUARD_SCIM_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "scim-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "http://placeholder.invalid/realms/example-corp/scim/v2",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "id": "99999999-9999-4999-8999-999999999999",
      "clientId": "e2e-growth-job-runner",
      "name": "E2E Customer Growth Job Runner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${E2E_WORKLOAD_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "customer-growth-job-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "direct-reader",
      "enabled": true,
      "firstName": "Direct",
      "lastName": "Reader",
      "email": "direct-reader@example-corp.example",
      "emailVerified": true,
      "requiredActions": [],
      "groups": ["/direct-readers"],
      "credentials": [
        { "type": "password", "value": "direct-reader-password", "temporary": false }
      ],
      "attributes": {
        "tenant_id": ["example-corp"],
        "authguard_group": ["direct-readers"],
        "authguard_group_ids": ["11111111-1111-4111-8111-111111111111"]
      }
    },
    {
      "username": "token-editor",
      "enabled": true,
      "firstName": "Token",
      "lastName": "Editor",
      "email": "token-editor@example-corp.example",
      "emailVerified": true,
      "requiredActions": [],
      "groups": ["/token-editors"],
      "credentials": [
        { "type": "password", "value": "token-editor-password", "temporary": false }
      ],
      "attributes": {
        "tenant_id": ["example-corp"],
        "authguard_group": ["token-editors"],
        "authguard_group_ids": ["22222222-2222-4222-8222-222222222222"]
      }
    },
    {
      "id": "77777777-7777-4777-8777-777777777777",
      "username": "service-account-e2e-authguard-principal-discovery",
      "enabled": true,
      "serviceAccountClientId": "e2e-authguard-principal-discovery",
      "clientRoles": {
        "realm-management": ["query-groups", "query-users", "view-users"]
      }
    },
    {
      "id": "77777777-7777-4777-8777-777777777779",
      "username": "service-account-e2e-scim-sync",
      "enabled": true,
      "serviceAccountClientId": "e2e-scim-sync",
      "clientRoles": {
        "realm-management": ["realm-admin"]
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "88888888-8888-4888-8888-888888888888",
        "name": "e2e-keycloak-ldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "a1111111-1111-4111-8111-111111111111",
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["givenName"],
                "is.mandatory.in.ldap": ["false"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "user.model.attribute": ["firstName"]
              }
            },
            {
              "id": "a2222222-2222-4222-8222-222222222222",
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "is.mandatory.in.ldap": ["false"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "user.model.attribute": ["lastName"]
              }
            },
            {
              "id": "a3333333-3333-4333-8333-333333333333",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "is.mandatory.in.ldap": ["false"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "user.model.attribute": ["email"]
              }
            },
            {
              "id": "a4444444-4444-4444-8444-444444444444",
              "name": "tenant id",
              "providerId": "hardcoded-attribute-mapper",
              "config": {
                "attribute.value": ["example-corp"],
                "user.model.attribute": ["tenant_id"]
              }
            },
            {
              "id": "a5555555-5555-4555-8555-555555555555",
              "name": "authguard group",
              "providerId": "hardcoded-attribute-mapper",
              "config": {
                "attribute.value": ["customer-growth-analysts"],
                "user.model.attribute": ["authguard_group"]
              }
            },
            {
              "id": "a6666666-6666-4666-8666-666666666666",
              "name": "authguard group ids",
              "providerId": "hardcoded-attribute-mapper",
              "config": {
                "attribute.value": ["5501"],
                "user.model.attribute": ["authguard_group_ids"]
              }
            },
            {
              "id": "a7777777-7777-4777-8777-777777777777",
              "name": "customer growth groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": ["dc=example,dc=org"],
                "groups.path": ["/"],
                "group.name.ldap.attribute": ["ou"],
                "group.object.classes": ["groupOfUniqueNames"],
                "preserve.group.inheritance": ["false"],
                "ignore.missing.groups": ["false"],
                "membership.ldap.attribute": ["uniqueMember"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["cn"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["${E2E_LDAP_ENABLED}"],
          "priority": ["0"],
          "importEnabled": ["false"],
          "editMode": ["READ_ONLY"],
          "vendor": ["other"],
          "usernameLDAPAttribute": ["cn"],
          "rdnLDAPAttribute": ["cn"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson, organizationalPerson, posixAccount"],
          "customUserSearchFilter": ["(objectClass=posixAccount)"],
          "connectionUrl": ["${E2E_LDAP_URL}"],
          "usersDn": ["dc=example,dc=org"],
          "authType": ["simple"],
          "bindDn": ["cn=svc-keycloak,ou=Users,dc=example,dc=org"],
          "bindCredential": ["${E2E_LDAP_BIND_PASSWORD}"],
          "searchScope": ["2"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "batchSizeForSync": ["1000"],
          "connectionTimeout": ["5000"],
          "readTimeout": ["5000"],
          "cachePolicy": ["NO_CACHE"],
          "fullSyncPeriod": ["-1"],
          "changedSyncPeriod": ["-1"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["true"]
        }
      }
    ]
  }
}
